# name: test/sql/decode_straddle.test
# description: A multi-byte character straddling the encoded-buffer boundary must survive (duckdb/duckdb#20598)
# group: [sql]

require encodings

# Each file places one multi-byte character across the end of the first 1024-byte encoded buffer

query I
SELECT right(value, 8) FROM read_csv('data/boundaries/straddle_cp932_1k.csv', header=true, all_varchar=true, encoding='ibm-943_P15A-2003', buffer_size=1024) WHERE key='z'
----
ppp市tail

query I
SELECT right(value, 8) FROM read_csv('data/boundaries/straddle_gb18030_1k.csv', header=true, all_varchar=true, encoding='gb18030', buffer_size=1024) WHERE key='z'
----
ppp¡tail

# The same split at the end of the second buffer, which ends a byte early since the decoder carries the last byte of the first

query I
SELECT right(value, 8) FROM read_csv('data/boundaries/straddle_cp932_2k.csv', header=true, all_varchar=true, encoding='ibm-943_P15A-2003', buffer_size=1024) WHERE key='z'
----
ppp市tail

query I
SELECT right(value, 8) FROM read_csv('data/boundaries/straddle_gb18030_2k.csv', header=true, all_varchar=true, encoding='gb18030', buffer_size=1024) WHERE key='z'
----
ppp¡tail

# Control: the same file decodes correctly when the character does not straddle a buffer boundary
query I
SELECT right(value, 8) FROM read_csv('data/boundaries/straddle_cp932_1k.csv', header=true, all_varchar=true, encoding='ibm-943_P15A-2003', buffer_size=4096) WHERE key='z'
----
ppp市tail
